#!/bin/python3


import config
from pathlib import Path
import subprocess
import argparse

VERSION = "0.1"


def choose_from_arr(arr, msg=''):
    n = len(arr)
    for i in range(n):
        print(f"{i}. {arr[i]}")

    if msg == '':
        msg = f"Please choose one of the choices [0-{n-1}]: "

    choice = int(input(msg))
    while not (choice <= n-1 and choice >= 0):
        print("Invalid choice, try again")
        choice = int(input(msg))

    return choice


def get_wine_versions():
    wine_dir = Path("~/.local/share/lutris/runners/wine/").expanduser()
    versions = list(wine_dir.iterdir())

    a = []
    for ver in versions:
        a.append(ver.name)

    a.append("system")  # system is not in that folder
    return a


def do_change_config(cfg):
    print("-- Settings --")
    settings = list(cfg.settings)

    choice = choose_from_arr(settings)
    if choice == 0:
        current = cfg.get(settings[choice])
        wines = get_wine_versions()

        custom_msg = f"Choose your new wine version (current: {current}): "
        new_version_idx = choose_from_arr(wines, custom_msg)
        new_version = wines[new_version_idx]

        cfg.set(settings[choice], new_version)
    else:  # currently only 2 settings so no point in elif
        current = cfg.get(settings[choice])
        new_path = input(f"New default game path (current: {current}): ")

        p = Path(new_path).expanduser()
        p.mkdir(parents=True, exist_ok=True)

        if not (p.exists() and p.is_dir()):
            raise ValueError("Could not create dir?")

        cfg.set(settings[choice], p)


def yaml_template(game_name, identifier, is_installer, wine_version):
    if is_installer:
        return f"""name: "{game_name}"
game_slug: {identifier}
version:  GameInstaller {VERSION}
slug: {identifier}_installer
runner: wine
description: "Generated by GameInstaller {VERSION}"


script:
    wine:
        version: {wine_version}
    files:
        - installer: "N/A: select the installer exe"
    game:
        exe: $GAMEDIR/game/replace.exe
        prefix: $GAMEDIR/prefix/
    installer:
        - task:
            name: wineexec
            executable: installer"""
    else:
        return f"""name: "{game_name}"
game_slug: {identifier}
version: GameInstaller {VERSION}
slug: {identifier}_installer
runner: wine
description: "Generated by GameInstaller {VERSION}"


script:
    wine:
        version: {wine_version}
    game:
        exe: $GAMEDIR/game/replace.exe
        prefix: $GAMEDIR/prefix/
    installer:
        - task:
            name: create_prefix
            arch: win64"""


def do_generate_script(cfg):
    default_wine = cfg.get("default_wine")
    available_wine = get_wine_versions()
    if default_wine not in available_wine:
        raise ValueError(f"config: {default_wine} is not installed.")

    print(f"Using {default_wine}")

    game_name = input("Enter the name of the game: ")
    is_installer = input("Does it include an installer (y/N): ").lower() == 'y'

    identifier = game_name.replace(' ', '-').lower()
    install_path = cfg.get("install_path")

    base = Path(install_path).expanduser() / identifier
    game = base / "game"
    prefix = base / "prefix"

    game.mkdir(parents=True, exist_ok=True)
    prefix.mkdir(parents=True, exist_ok=True)

    install_script = base / "install.yaml"
    with install_script.open('w') as f:
        data = yaml_template(game_name, identifier, is_installer, default_wine)
        f.write(data)

    print("Starting lutris..")
    subprocess.run(["lutris", "-i", install_script], check=True)


def main():
    cfg = config.Config()
    parser = argparse.ArgumentParser(
            prog="gameInstaller",
            description="A YAML install script generator for lutris"
    )

    parser.add_argument('-v', "--version", action="store_true")
    parser.add_argument("-c", "--config", action="store_true")

    args = parser.parse_args()
    if args.version:
        print(f"GameInstaller {VERSION}")
    elif args.config:
        do_change_config(cfg)
    else:
        do_generate_script(cfg)


if __name__ == "__main__":
    main()
